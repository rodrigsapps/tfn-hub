local function tpTo(cf)
    local hrp = getHRP()
    if not hrp or not cf then return false end
    pcall(function() hrp.CFrame = cf end)
    return true
end

local function tweenTo(cf, speed)
    local hrp = getHRP()
    if not hrp or not cf then return end
    local dist = (hrp.Position - cf.Position).Magnitude
    local t = math.clamp(dist / (speed or 120), 0.1, 8)
    local tw = TweenService:Create(hrp, TweenInfo.new(t, Enum.EasingStyle.Linear), { CFrame = cf })
    tw:Play()
    tw.Completed:Wait()
end

local function firePrompt(p)
    if typeof(p) ~= "Instance" or not p:IsA("ProximityPrompt") then return end
    pcall(function()
        local hold = p.HoldDuration
        p.HoldDuration = 0
        if fireproximityprompt then
            fireproximityprompt(p)
        else
            p:InputHoldBegin()
            task.wait()
            p:InputHoldEnd()
        end
        p.HoldDuration = hold
    end)
end

local function promptsNear(radius, filter)
    local out = {}
    local hrp = getHRP()
    if not hrp then return out end
    for _, v in ipairs(Workspace:GetDescendants()) do
        if v:IsA("ProximityPrompt") and v.Enabled then
            local part = v.Parent
            if part and part:IsA("BasePart") then
                if (part.Position - hrp.Position).Magnitude <= (radius or 40) then
                    if (not filter) or filter(v) then
                        table.insert(out, v)
                    end
                end
            end
        end
    end
    return out
end

local function touchPart(part)
    local hrp = getHRP()
    if not hrp or not part or not part:IsA("BasePart") then return end
    pcall(function()
        if firetouchinterest then
            firetouchinterest(hrp, part, 0)
            task.wait()
            firetouchinterest(hrp, part, 1)
        else
            local old = hrp.CFrame
            hrp.CFrame = part.CFrame
            task.wait(0.12)
            hrp.CFrame = old
        end
    end)
end

local function lowerName(x) return string.lower(tostring(x)) end

local function looksLikeEgg(inst)
    local n = lowerName(inst.Name)
    return string.find(n, "egg") ~= nil or string.find(n, "ovo") ~= nil
end

local function looksLikeCoin(inst)
    local n = lowerName(inst.Name)
    return string.find(n, "coin") ~= nil or string.find(n, "cash") ~= nil
        or string.find(n, "money") ~= nil or string.find(n, "dinheiro") ~= nil
end

local function partOf(inst)
    if not inst then return nil end
    if inst:IsA("BasePart") then return inst end
    if inst:IsA("Model") then
        return inst.PrimaryPart or inst:FindFirstChildWhichIsA("BasePart")
    end
    return inst:FindFirstChildWhichIsA("BasePart", true)
end

-- coleta candidatos de ovo no mapa
local function findEggs(radius)
    local res = {}
    local hrp = getHRP()
    if not hrp then return res end
    for _, v in ipairs(Workspace:GetDescendants()) do
        if (v:IsA("Model") or v:IsA("BasePart") or v:IsA("Tool")) and looksLikeEgg(v) then
            local p = partOf(v)
            if p and (p.Position - hrp.Position).Magnitude <= (radius or S.eggRange) then
                table.insert(res, { inst = v, part = p, dist = (p.Position - hrp.Position).Magnitude })
            end
        end
    end
    table.sort(res, function(a, b) return a.dist < b.dist end)
    return res
end

