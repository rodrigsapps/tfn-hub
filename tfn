local Net = {}
Net.folder = nil

function Net:Folder()
    if self.folder and self.folder.Parent then return self.folder end
    local pkgs = ReplicatedStorage:FindFirstChild("Packages")
    if pkgs then
        local n = pkgs:FindFirstChild("Networking")
        if n then self.folder = n return n end
    end
    -- fallback: procura em qualquer lugar
    for _, v in ipairs(ReplicatedStorage:GetDescendants()) do
        if v.Name == "Networking" and (v:IsA("Folder") or v:IsA("Configuration") or v:IsA("Model")) then
            self.folder = v
            return v
        end
    end
    return nil
end

function Net:Get(name)
    local f = self:Folder()
    if not f then return nil end
    local r = f:FindFirstChild(name)
    if r then return r end
    -- busca profunda (alguns executores/versoes mudam a hierarquia)
    for _, v in ipairs(f:GetDescendants()) do
        if v.Name == name then return v end
    end
    return nil
end

function Net:Fire(name, ...)
    local r = self:Get(name)
    if not r then return false end
    local args = {...}
    local ok = pcall(function()
        if r:IsA("RemoteEvent") then
            r:FireServer(unpack(args))
        elseif r:IsA("RemoteFunction") then
            r:InvokeServer(unpack(args))
        elseif r:IsA("BindableEvent") then
            r:Fire(unpack(args))
        end
    end)
    return ok
end

function Net:Invoke(name, ...)
    local r = self:Get(name)
    if not r then return nil end
    local args = {...}
    local ok, res = pcall(function()
        if r:IsA("RemoteFunction") then
            return r:InvokeServer(unpack(args))
        elseif r:IsA("RemoteEvent") then
            r:FireServer(unpack(args))
            return true
        end
    end)
    if ok then return res end
    return nil
end

