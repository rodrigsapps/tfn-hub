local function findByKeywords(words)
    local best
    for _, v in ipairs(Workspace:GetDescendants()) do
        local n = lowerName(v.Name)
        for _, w in ipairs(words) do
            if string.find(n, w) then
                local p = partOf(v)
                if p then best = p break end
            end
        end
        if best then break end
    end
    return best
end

local function tpKeyword(words, label)
    local p = findByKeywords(words)
    if p then
        tpTo(p.CFrame * CFrame.new(0, 4, 0))
        return true
    end
    notifyCore("TFN HUB", "Nao encontrei: " .. tostring(label))
    return false
end

local function myBase()
    local plots = Workspace:FindFirstChild("Plots") or Workspace:FindFirstChild("Bases")
        or Workspace:FindFirstChild("Homesteads")
    if plots then
        for _, plot in ipairs(plots:GetChildren()) do
            for _, d in ipairs(plot:GetDescendants()) do
                if d:IsA("StringValue") or d:IsA("ObjectValue") then
                    local val = tostring(d.Value)
                    if val == LocalPlayer.Name or val == LocalPlayer.DisplayName then
                        return partOf(plot)
                    end
                end
                if d:IsA("TextLabel") and string.find(lowerName(d.Text), lowerName(LocalPlayer.Name)) then
                    return partOf(plot)
                end
            end
        end
    end
    return nil
end

local function tpPlayer(name)
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= LocalPlayer and (plr.Name == name or plr.DisplayName == name) then
            local ch = plr.Character
            local h = ch and ch:FindFirstChild("HumanoidRootPart")
            if h then
                tpTo(h.CFrame * CFrame.new(0, 0, 3))
                return true
            end
        end
    end
    notifyCore("TFN HUB", "Jogador nao encontrado / sem personagem.")
    return false
end

local function playerList()
    local t = {}
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= LocalPlayer then table.insert(t, plr.Name) end
    end
    if #t == 0 then table.insert(t, "-- ninguem --") end
    return t
end

