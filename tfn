local Threads = {}

-- loop protegido: roda enquanto flag() for verdadeiro
local function loop(name, flagFn, fn, defDelay)
    if Threads[name] then return end
    Threads[name] = true
    task.spawn(function()
        while Threads[name] do
            if flagFn() then
                pcall(fn)
            end
            task.wait(defDelay or 0.5)
        end
    end)
end

